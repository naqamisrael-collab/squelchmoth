# Cross-compile Squelchmoth for macOS from Linux using osxcross.
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(OSXCROSS /home/claude/osxcross/target)
set(CMAKE_C_COMPILER ${OSXCROSS}/bin/x86_64-apple-darwin22.4-clang)
set(CMAKE_CXX_COMPILER ${OSXCROSS}/bin/x86_64-apple-darwin22.4-clang++)
set(CMAKE_AR ${OSXCROSS}/bin/x86_64-apple-darwin22.4-ar)
set(CMAKE_RANLIB ${OSXCROSS}/bin/x86_64-apple-darwin22.4-ranlib)
set(CMAKE_INSTALL_NAME_TOOL ${OSXCROSS}/bin/x86_64-apple-darwin22.4-install_name_tool)
set(CMAKE_OSX_SYSROOT ${OSXCROSS}/SDK/MacOSX13.3.sdk)
set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0)
set(CMAKE_FIND_ROOT_PATH ${OSXCROSS}/SDK/MacOSX13.3.sdk)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")

# identical floating-point rounding on every platform (no fused multiply-add): DSP measures the same on Apple Silicon as on Intel
set(CMAKE_C_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -ffp-contract=off")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_CXX_FLAGS_INIT} -ffp-contract=off")
