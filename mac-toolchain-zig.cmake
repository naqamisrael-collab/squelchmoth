# Cross-compile Squelchmoth for macOS (Intel) from Linux with zig as the compiler/linker and the Apple SDK headers.
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(ZIGMAC /home/claude/zigmac/bin)
set(MACSDK /home/claude/macsdk/MacOSX13.3.sdk)
set(CMAKE_C_COMPILER ${ZIGMAC}/x86_64-apple-darwin-clang)
set(CMAKE_CXX_COMPILER ${ZIGMAC}/x86_64-apple-darwin-clang++)
set(CMAKE_AR ${ZIGMAC}/x86_64-apple-darwin-ar)
set(CMAKE_RANLIB ${ZIGMAC}/x86_64-apple-darwin-ranlib)
set(CMAKE_INSTALL_NAME_TOOL /usr/lib/llvm-18/bin/llvm-install-name-tool)
set(CMAKE_OSX_SYSROOT ${MACSDK})
set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0)
set(CMAKE_OSX_ARCHITECTURES x86_64)
set(CMAKE_FIND_ROOT_PATH ${MACSDK})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_COMPILER_WORKS 1)
set(CMAKE_CXX_COMPILER_WORKS 1)

# identical floating-point rounding on every platform (no fused multiply-add): DSP measures the same on Apple Silicon as on Intel
set(CMAKE_C_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -ffp-contract=off")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_CXX_FLAGS_INIT} -ffp-contract=off")
